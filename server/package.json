{
  "name": "vertice-invest-server",
  "version": "1.6.2",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node --max-old-space-size=300 index.js",
    "dev": "nodemon index.js --ignore logs/ --ignore **/*.log --ignore crash-report.txt",
    "test": "vitest",
    "test:wallet": "vitest run tests/wallet_snapshot.spec.js",
    "test:regression": "vitest run tests/quant_regression.spec.js",
    "test:all": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:stress": "node server/scripts/stressTest2020.js",
    "test:fundamentus": "node tests/test_fundamentus.js",
    "sync:prod": "node server/scripts/syncProdData.js",
    "sync:TimeSeriesWorker": "node scripts/syncTimeSeries.js",
    "clean:dividends": "node scripts/cleanDuplicateDividends.js",
    "backfill:sectors": "node scripts/backfillSectors.js",
    "backfill:b3": "node scripts/backfillB3Closes.js",
    "backfill:logos": "node scripts/backfillLogos.js",
    "lint": "node --check index.js",
    "build": "node scripts/build.js",
    "backtest:portfolio": "node scripts/seedPortfolioBacktest.js",
    "seed:wallet": "node scripts/seedFullWallet.js",
    "benchmark:http": "node scripts/benchmarkHttp.js",
    "benchmark:mongo": "node scripts/benchmarkMongo.js",
    "benchmark:phase3": "node scripts/benchmarkPhase3.js",
    "check:email": "node scripts/checkEmail.js"
  },
  "dependencies": {
    "@google/genai": "^1.38.0",
    "@sentry/node": "^8.0.0",
    "@sentry/profiling-node": "^8.0.0",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "iconv-lite": "^0.6.3",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^2.0.8",
    "mongoose": "^8.24.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.0.0",
    "otplib": "^13.4.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.11.0",
    "yahoo-finance2": "^3.15.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "nodemon": "^3.0.0",
    "vitest": "^5.0.0"
  }
}
